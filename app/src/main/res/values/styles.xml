<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FF5A45</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
        <item name="android:windowAnimationStyle">@style/AppWindowAnimation</item>
        <item name="android:navigationBarColor">#111111</item>
        <item name="android:statusBarColor">#111111</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppWindowAnimation">
        <item name="android:windowEnterAnimation">@anim/app_slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/app_slide_out_left</item>
    </style>

    <style name="AppDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">#E94B35</item>
        <item name="android:colorControlActivated">#E94B35</item>
        <item name="android:colorControlNormal">#AAA59D</item>
        <item name="android:textColorPrimary">#F5F1EB</item>
        <item name="android:textColorSecondary">#AAA59D</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AppDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/AppDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/AppDialogButton</item>
    </style>

    <style name="AppDialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#E94B35</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
