<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#141414">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
        <Button android:id="@+id/editor_back" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_dark_button" android:text="‹" android:textColor="#F5F1EB" android:textSize="28sp" />
        <TextView android:id="@+id/editor_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Nova receita" android:textColor="#F5F1EB" android:textSize="22sp" android:textStyle="bold" />
        <Space android:layout_width="48dp" android:layout_height="48dp" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="32dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Foto da receita" android:textColor="#F5F1EB" android:textSize="18sp" android:textStyle="bold" android:paddingTop="8dp" android:paddingBottom="8dp" />
            <ImageView android:id="@+id/editor_photo_preview" android:layout_width="match_parent" android:layout_height="180dp" android:background="@drawable/bg_surface" android:scaleType="centerCrop" android:contentDescription="Foto principal da receita" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <Button android:id="@+id/editor_choose_photo" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_dark_button" android:text="Escolher foto" android:textAllCaps="false" android:textColor="#F5F1EB" />
                <Button android:id="@+id/editor_take_photo" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/bg_dark_button" android:text="Tirar foto" android:textAllCaps="false" android:textColor="#F5F1EB" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Banner da receita" android:textColor="#F5F1EB" android:textSize="18sp" android:textStyle="bold" android:paddingTop="20dp" android:paddingBottom="8dp" />
            <ImageView android:id="@+id/editor_banner_preview" android:layout_width="match_parent" android:layout_height="140dp" android:background="@drawable/bg_surface" android:scaleType="centerCrop" android:contentDescription="Banner da receita" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
                <Button android:id="@+id/editor_choose_banner" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_dark_button" android:text="Escolher banner" android:textAllCaps="false" android:textColor="#F5F1EB" />
                <Button android:id="@+id/editor_take_banner" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/bg_dark_button" android:text="Fotografar banner" android:textAllCaps="false" android:textColor="#F5F1EB" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Informações básicas" android:textColor="#F5F1EB" android:textSize="18sp" android:textStyle="bold" android:paddingTop="24dp" android:paddingBottom="8dp" />
            <EditText android:id="@+id/editor_title_input" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_surface" android:hint="Nome da receita" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="#F5F1EB" android:textColorHint="#AAA59D" android:textSize="16sp" />
            <EditText android:id="@+id/editor_description_input" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="10dp" android:background="@drawable/bg_surface" android:gravity="top" android:hint="Descrição (opcional)" android:inputType="textMultiLine" android:padding="16dp" android:textColor="#F5F1EB" android:textColorHint="#AAA59D" android:textSize="16sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <EditText android:id="@+id/editor_category_input" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/bg_surface" android:hint="Selecionar categorias" android:focusable="false" android:clickable="true" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="#F5F1EB" android:textColorHint="#AAA59D" android:textSize="16sp" />
                <EditText android:id="@+id/editor_servings_input" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginStart="10dp" android:background="@drawable/bg_surface" android:hint="Porções" android:inputType="number" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="#F5F1EB" android:textColorHint="#AAA59D" android:textSize="16sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ingredientes" android:textColor="#F5F1EB" android:textSize="18sp" android:textStyle="bold" android:paddingTop="24dp" android:paddingBottom="8dp" />
            <LinearLayout android:id="@+id/editor_ingredients_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <Button android:id="@+id/editor_add_ingredient" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_dark_button" android:text="+  Adicionar ingrediente" android:textAllCaps="false" android:textColor="#F5F1EB" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Modo de preparo" android:textColor="#F5F1EB" android:textSize="18sp" android:textStyle="bold" android:paddingTop="24dp" android:paddingBottom="8dp" />
            <LinearLayout android:id="@+id/editor_steps_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <Button android:id="@+id/editor_add_step" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_dark_button" android:text="+  Adicionar etapa" android:textAllCaps="false" android:textColor="#F5F1EB" />
            <Button android:id="@+id/editor_save" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="26dp" android:background="@drawable/bg_accent" android:text="Salvar receita" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/editor_risk_zone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Risk zone" android:textColor="#F07868" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="A exclusão é permanente e não apaga outras receitas." android:textColor="#AAA59D" android:textSize="14sp" />
                <Button android:id="@+id/editor_delete" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_dark_button" android:text="Excluir receita" android:textAllCaps="false" android:textColor="#F07868" android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
