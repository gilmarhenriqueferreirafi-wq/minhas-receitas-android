<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:animateLayoutChanges="true"
    android:background="#141414">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/home_add"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_accent"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Minhas Receitas"
                    android:textColor="#F5F1EB"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/home_settings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_dark_button"
                    android:text="⚙"
                    android:textColor="#F5F1EB"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_featured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_featured"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/home_featured_photo"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:background="#000000"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto da receita mais acessada" />

                <TextView
                    android:id="@+id/home_featured_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥  MAIS ACESSADA"
                    android:textColor="#FFC078"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_featured_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="#F5F1EB"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_featured_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="3"
                    android:textColor="#D4CCC4"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/home_featured_open"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_accent"
                    android:text="Ver receita  →"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/home_featured_indicator"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#D4CCC4"
                        android:textSize="13sp" />
                    <Button
                        android:id="@+id/home_featured_previous"
                        android:layout_width="42dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_dark_button"
                        android:text="&lt;"
                        android:textColor="#F5F1EB"
                        android:textSize="22sp" />
                    <Button
                        android:id="@+id/home_featured_next"
                        android:layout_width="42dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_dark_button"
                        android:text=">"
                        android:textColor="#F5F1EB"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Minhas receitas"
                    android:textColor="#F5F1EB"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/home_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dark_button"
                    android:text="Ver todas"
                    android:textAllCaps="false"
                    android:textColor="#E94B35" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
            android:background="#202020"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_dark_button"
            android:text="⌂\nInício"
            android:textAllCaps="false"
            android:textColor="#E94B35" />
        <Button
            android:id="@+id/nav_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_surface"
            android:text="⌕\nBuscar"
            android:textAllCaps="false"
            android:textColor="#AAA59D" />
        <Button
            android:id="@+id/nav_favorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_surface"
            android:text="♡\nFavoritos"
            android:textAllCaps="false"
            android:textColor="#AAA59D" />
        <Button
            android:id="@+id/nav_categories"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_surface"
            android:text="▦\nCategorias"
            android:textAllCaps="false"
            android:textColor="#AAA59D" />
        <Button
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_surface"
            android:text="⚙\nConfig."
            android:textAllCaps="false"
            android:textColor="#AAA59D" />
    </LinearLayout>
</LinearLayout>
